# Market_Sentry Configuration Example
# Copy this file to .env and update with your values

# Database
DATABASE_PATH=db/marketsentry.db

# Data directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EXPORTS_DIR=data/exports
DATA_IMPORTS_DIR=data/imports

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/marketsentry.log

# Redfin search URLs
REDFIN_MURRIETA_URL=https://www.redfin.com/city/12866/CA/Murrieta/filter/property-type=house,min-price=550k,max-price=990k,min-beds=2,min-baths=2,min-parking=2,pool-type=no-private,mr=6:19701
REDFIN_TEMECULA_URL=https://www.redfin.com/city/19701/CA/Temecula/filter/property-type=house,min-price=550k,max-price=990k,min-beds=2,min-baths=2,min-parking=2,pool-type=no-private,mr=6:12866

# Scoring thresholds
QUIET_SCORE_MINIMUM=7.0
QUIET_SCORE_TARGET=8.0
VIBRANCY_SCORE_TARGET_MAX=2.5
QUIET_SCORE_EXCELLENT=9.0
VIBRANCY_SCORE_EXCELLENT_MAX=2.0

# Effective DOM settings
EFFECTIVE_DOM_LOOKBACK_DAYS=365

# Live retrieval settings (disabled by default)
MARKETSENTRY_LIVE_RETRIEVAL_ENABLED=false
MARKETSENTRY_ALLOWED_LIVE_SOURCES=
MARKETSENTRY_LIVE_USER_AGENT=
MARKETSENTRY_LIVE_CONTACT_EMAIL=
MARKETSENTRY_MAX_REQUESTS_PER_MINUTE=6
MARKETSENTRY_REQUIRE_DRY_RUN_BEFORE_LIVE=true
